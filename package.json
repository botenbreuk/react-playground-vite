{
  "name": "react-playground-vite",
  "private": true,
  "type": "module",
  "version": "0.0.1",
  "dependencies": {
    "@42.nl/react-url": "3.3.2",
    "@date-fns/utc": "2.1.1",
    "@hookform/resolvers": "5.7.1",
    "@mdxeditor/editor": "4.2.0",
    "@tanstack/react-query": "5.101.4",
    "axios": "1.19.0",
    "bootstrap": "5.3.8",
    "bootstrap-icons": "1.13.1",
    "classnames": "2.5.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "final-form": "5.0.1",
    "final-form-arrays": "4.0.1",
    "immutability-helper": "3.1.1",
    "lodash": "4.18.1",
    "moment": "2.30.1",
    "react": "19.2.8",
    "react-datepicker": "9.1.0",
    "react-datetime": "3.3.1",
    "react-dnd": "16.0.1",
    "react-dnd-html5-backend": "16.0.1",
    "react-dom": "19.2.8",
    "react-final-form": "7.0.1",
    "react-final-form-arrays": "5.0.0",
    "react-hook-form": "7.84.0",
    "react-icons": "5.7.0",
    "react-router": "8.3.0",
    "reactstrap": "9.2.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.25",
    "@types/node": "26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "better-npm-audit": "3.11.0",
    "csp-header": "6.3.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-organize-imports": "4.3.0",
    "sass": "1.102.0",
    "stylelint": "17.14.1",
    "stylelint-config-prettier-scss": "1.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.0",
    "vite-plugin-checker": "0.14.5"
  },
  "scripts": {
    "better-audit": "node node_modules/better-npm-audit audit --production",
    "build": "tsc && vite build",
    "check-dependencies": "node ci/check-dependencies.ts",
    "check-project": "npm run check-dependencies && npm run lint && npm run ts",
    "lint": "ESLINT_USE_FLAT_CONFIG=true eslint src --max-warnings 0",
    "lint-perf": "TIMING=all ESLINT_USE_FLAT_CONFIG=true eslint src --max-warnings 0",
    "prepare": "husky",
    "prettier": "prettier --write ./src",
    "preview": "vite build --mode preview && vite preview",
    "sass-check": "sass src/styles/main.scss /dev/null --no-source-map --quiet-deps --load-path node_modules",
    "start": "ulimit -n 65536 2>/dev/null; vite",
    "start-api": "cd _rest-api && npm start",
    "stylelint": "stylelint \"src/**/*.{css,scss}\"",
    "stylelint-check": "stylelint-config-prettier-scss-check",
    "test-all": "npm run check-dependencies && npm run lint && npm run ts",
    "ts": "tsc --version && tsc"
  },
  "lint-staged": {
    "{src,test}/**/*.{js,jsx,json,scss,tsx,ts}": [
      "prettier --single-quote --write"
    ]
  }
}
